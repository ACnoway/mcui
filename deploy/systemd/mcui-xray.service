[Unit]
Description=MCUI-managed Xray Core
Documentation=https://github.com/ACnoway/mcui

[Service]
Type=exec
DynamicUser=yes
User=mcui-xray
UMask=0077
WorkingDirectory=/var/lib/mcui-xray/current
Environment=XRAY_LOCATION_ASSET=/var/lib/mcui-xray/current
StandardInput=file:/var/lib/mcui-xray/control/runtime-config.json
ExecStart=/var/lib/mcui-xray/current/xray run -config stdin:
Restart=no
TimeoutStartSec=15s
TimeoutStopSec=10s
TasksMax=128
MemoryMax=256M
LimitNOFILE=4096
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_INET AF_INET6
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
InaccessiblePaths=-/etc/mcui -/etc/mcui-agent -/var/lib/mcui -/var/lib/mcui-agent -/var/lib/mcui-helper -/run/mcui
