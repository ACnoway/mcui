[Unit]
Description=Reconcile the durable MCUI Xray selection at boot
Documentation=https://github.com/ACnoway/mcui
After=local-fs.target
ConditionPathIsDirectory=/var/lib/mcui-xray

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mcui-xray recover
TimeoutStartSec=90s
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mcui-xray
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
