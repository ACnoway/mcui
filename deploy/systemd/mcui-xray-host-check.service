[Unit]
Description=Verify MCUI Xray host-network egress guard
Requires=mcui-xray-host-network.service
After=mcui-xray-host-network.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/mcui-xray-host-network verify
User=root
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
