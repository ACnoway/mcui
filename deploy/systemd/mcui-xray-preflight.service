[Unit]
Description=MCUI Xray candidate preflight
Documentation=https://github.com/ACnoway/mcui

[Service]
Type=oneshot
DynamicUser=yes
User=mcui-xray-preflight
UMask=0077
WorkingDirectory=/var/lib/mcui-xray/candidate
Environment=XRAY_LOCATION_ASSET=/var/lib/mcui-xray/candidate
LoadCredential=config.json:/var/lib/mcui-xray/control/candidate-config.json
ExecStart=/var/lib/mcui-xray/candidate/xray run -test -config %d/config.json
StandardOutput=null
StandardError=null
TimeoutStartSec=12s
TimeoutStopSec=5s
TasksMax=128
MemoryMax=256M
LimitNOFILE=4096
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_INET AF_INET6
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
InaccessiblePaths=-/etc/mcui -/etc/mcui-agent -/var/lib/mcui -/var/lib/mcui-agent -/var/lib/mcui-helper -/run/mcui
