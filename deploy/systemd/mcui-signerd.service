[Unit]
Description=MCUI isolated status-task signing service
Documentation=https://github.com/ACnoway/mcui
After=network.target

[Service]
Type=simple
User=mcui-signer
Group=mcui-task
UMask=0077
EnvironmentFile=/etc/mcui-task-signer/signer.env
ExecStart=/usr/local/bin/mcui-signerd -listen 127.0.0.1:9231 -key-id ${MCUI_TASK_KEY_ID} -key-file /etc/mcui-task-signer/task-key.pem -token-file /etc/mcui-task-signer/token
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET
ReadOnlyPaths=/etc/mcui-task-signer

[Install]
WantedBy=multi-user.target
