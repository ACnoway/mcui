[Unit]
Description=MCUI independent checkpoint authority
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcui-checkpoint
Group=mcui-checkpoint
UMask=0077
EnvironmentFile=/etc/mcui-checkpoint/checkpoint.env
StateDirectory=mcui-checkpoint
StateDirectoryMode=0700
ExecStart=/usr/local/bin/mcui-checkpointd serve -db /var/lib/mcui-checkpoint/authority.db -listen ${MCUI_CHECKPOINT_LISTEN} -tls-cert /etc/mcui-checkpoint/server-chain.pem -tls-key /etc/mcui-checkpoint/server-key.pem -client-ca /etc/mcui-checkpoint/client-ca.pem -client-key-sha256 ${MCUI_CHECKPOINT_CLIENT_KEY_SHA256}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
