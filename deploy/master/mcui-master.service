[Unit]
Description=MCUI single-admin Master
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=mcui-master
Group=mcui-master
UMask=0077
EnvironmentFile=-/etc/mcui-master/panel.env
StateDirectory=mcui-master
StateDirectoryMode=0750
ExecStart=/opt/mcui-master/current/mcui-panel -single-admin -db /var/lib/mcui-master/mcui.db -web /opt/mcui-master/current/web -core-backup-dir /var/lib/mcui-master/core-backups
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
